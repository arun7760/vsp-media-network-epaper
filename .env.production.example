APP_NAME="VSP TIMES E-Paper"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://epaper.vspmedianetwork.com

APP_LOCALE=te
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL Database (Hostinger Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_epaper
DB_USERNAME=u123456789_epaperuser
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Session and Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.vspmedianetwork.com
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
CACHE_PREFIX=vsp_epaper_cache_

QUEUE_CONNECTION=database

# Private and Public Storage Disks
FILESYSTEM_DISK=local

# Mail Notification
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=epaper@vspmedianetwork.com
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD_HERE
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="epaper@vspmedianetwork.com"
MAIL_FROM_NAME="VSP TIMES E-Paper"

# E-Paper Google Analytics 4 (GA4) Stream
EPAPER_GA4_MEASUREMENT_ID=G-VHYRSKXX6D
GTM_CONTAINER_ID=
GOOGLE_ADS_CONVERSION_ID=

VITE_APP_NAME="${APP_NAME}"
